# Copy to .env or set in your shell before running real (non-mock) experiments.
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides (defaults: claude-opus-5 everywhere)
# QVF_ADAPTER_MODEL=claude-opus-5
# QVF_GENERATOR_MODEL=claude-opus-5
# QVF_JUDGE_MODEL=claude-opus-5

# Set to 1 to run the full pipeline without any API calls (plumbing tests)
# QVF_MOCK=1
