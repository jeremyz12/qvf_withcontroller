# 密钥与环境 —— 永不入库
.env
.env.*
!.env.example

# 缓存
__pycache__/
*.pyc
.pytest_cache/

# 超过/接近 GitHub 单文件上限的大数据文件(公开数据可再生/可下载;再生命令见 README)
