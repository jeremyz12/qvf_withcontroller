<View>
  <Style>.gold-box{background:#eef3e8;border-radius:6px;padding:8px 12px;font-size:16px}</Style>
  <Header value="Type: $qtype   |   ID: $item_id"/>
  <Text name="q" value="$question"/>
  <View className="gold-box"><Header size="4" value="Gold answer: $gold"/></View>
  <HyperText name="chain" value="$chain_html" inline="false"/>
  <HyperText name="raw" value="$raw_html" inline="false"/>
  <Header size="4" value="Given the state chain and the convention above, is the gold answer correct? (Use the raw memory box to check the anchors in context and to look for state declarations the chain may have missed.)"/>
  <Choices name="verdict" toName="q" choice="single" required="true">
    <Choice value="Correct" hotkey="1"/>
    <Choice value="Incorrect" hotkey="2"/>
    <Choice value="Unsure" hotkey="3"/>
  </Choices>
  <Header size="5" value="Notes (explain briefly if Incorrect — including if you disagree with the convention itself)"/>
  <TextArea name="note" toName="q" rows="2" maxSubmissions="1"/>
</View>
